<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <title>Chaos Gate Report</title>
    <style>
      body { font-family: Arial, sans-serif; margin: 2rem; color: #1f2937; }
      .status { padding: 1rem 1.25rem; border-radius: 8px; font-weight: bold; margin-bottom: 1rem; }
      .PROMOTED { background: #dcfce7; color: #166534; }
      .ABORTED { background: #fee2e2; color: #991b1b; }
      table { width: 100%; border-collapse: collapse; margin-top: 1rem; }
      th, td { border: 1px solid #d1d5db; padding: 0.75rem; text-align: left; }
      th { background: #f3f4f6; }
      .meta { margin-bottom: 1.5rem; }
      .link { color: #1d4ed8; }
    </style>
  </head>
  <body>
    <h1>Chaos Gate Report</h1>
    <div class="status {{ decision }}">Decision: {{ decision }}</div>

    <div class="meta">
      <p><strong>Rollout:</strong> {{ rollout_name }}</p>
      <p><strong>Namespace:</strong> {{ namespace }}</p>
      <p><strong>Timestamp (UTC):</strong> {{ timestamp }}</p>
    </div>

    <h2>Experiment Results</h2>
    <table>
      <thead>
        <tr>
          <th>Name</th>
          <th>Duration</th>
          <th>Verdict</th>
        </tr>
      </thead>
      <tbody>
        {% for experiment in experiments %}
        <tr>
          <td>{{ experiment.name }}</td>
          <td>{{ experiment.duration }}s</td>
          <td>{{ experiment.verdict }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>

    <h2>SLO Monitoring Summary</h2>
    <p><strong>Service:</strong> {{ service_name }}</p>
    <p><strong>Max burn rate seen:</strong> {{ max_burn_seen }}</p>
    <p><strong>Threshold:</strong> {{ threshold }}</p>
    <p><strong>Budget pass:</strong> {{ budget_ok }}</p>

    <p><strong>Decision reason:</strong> {{ reason }}</p>
    {% if grafana_url %}
    <p><strong>Grafana:</strong> <a class="link" href="{{ grafana_url }}">{{ grafana_url }}</a></p>
    {% endif %}
  </body>
</html>
